{
  "name": "@autenai/sdk",
  "version": "1.0.0",
  "description": "SDK + CLI for controlling Android phones through the Auten relay — send tasks, manage credentials, watch live screens.",
  "license": "MIT",
  "author": "Auten <hello@auten.ai>",
  "homepage": "https://auten.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AutenAI/auten-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/AutenAI/auten-sdk/issues"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "auten": "bin/auten.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "android",
    "automation",
    "mobile",
    "accessibility",
    "agent",
    "auten",
    "phone-control",
    "ai",
    "sdk",
    "cli"
  ]
}
